{
  "name": "s-browser",
  "productName": "S Browser",
  "version": "1.5.0",
  "description": "S Browser — изолированный браузер на Chromium, работающий только через прокси",
  "author": "S Browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stinovuse/Proxy-browser.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^25.1.8",
    "@electron/fuses": "^1.8.0"
  },
  "build": {
    "appId": "local.proxybrowser",
    "productName": "S Browser",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "tab-preload.js",
      "ui/**",
      "lib/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "S Browser",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "SBrowser-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "ru_RU"
      ],
      "multiLanguageInstaller": true,
      "runAfterFinish": true,
      "menuCategory": false,
      "displayLanguageSelector": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Stinovuse",
        "repo": "Proxy-browser",
        "releaseType": "release"
      }
    ],
    "afterPack": "build/after-pack.js"
  }
}
