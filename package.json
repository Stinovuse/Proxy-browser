{
  "name": "proxy-browser",
  "productName": "Proxy Browser",
  "version": "1.2.0",
  "description": "Изолированный браузер на Chromium, работающий только через прокси",
  "author": "Proxy Browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.proxybrowser",
    "productName": "Proxy Browser",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["main.js", "preload.js", "ui/**"],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Proxy Browser",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
